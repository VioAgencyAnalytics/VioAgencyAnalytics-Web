APP_NAME="VioAgencyAnalytics"
APP_ENV="development"
DEBUG=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kdh_report"

# Legacy standalone diagnostic scripts only; not Web runtime configuration.
# Production provider OAuth and secrets belong exclusively to Admin.
# GOOGLE REAL DATA
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=
GSC_PROPERTY_URL=

# META REAL DATA
META_API_VERSION=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# TIKTOK REAL DATA
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Customer BFF: no database/provider credential is needed by this feature on Web.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_BACKEND_URL=http://127.0.0.1:8094
CUSTOMER_WEB_ORIGIN=http://127.0.0.1:8084
CUSTOMER_SERVICE_TOKEN=
