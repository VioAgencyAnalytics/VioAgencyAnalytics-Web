APP_NAME="VioAgencyAnalytics"
APP_ENV="development"
DEBUG=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kdh_report"
# =========================================================
# VioAgencyAnalytics Admin - INTERNAL REPORT API
# =========================================================

REPORT_ADMIN_BASE_URL=http://localhost:8090
# Browser origins for handoff; must match Admin APP_URL / REPORT_NEW_BASE_URL.
# Backend can use http://admin:8090; never put Docker hostnames in these public URLs.
REPORT_ADMIN_PUBLIC_URL=http://localhost:8090
REPORT_NEW_PUBLIC_URL=http://localhost:8080
REPORT_SERVICE_TOKEN=
REPORT_REQUEST_TIMEOUT_SECONDS=5

# Explicit local dual-Admin mode. Disabled unless both backends are configured.
REPORT_VIO_VIEWER_ENABLED=false
REPORT_VIO_ADMIN_BASE_URL=
REPORT_VIO_ADMIN_PUBLIC_URL=
REPORT_VIO_NEW_PUBLIC_URL=
REPORT_VIO_SERVICE_TOKEN=

# Protected developer preview only; always blocked in production.
REPORT_PREVIEW_ENABLED=false
REPORT_PREVIEW_USERNAME=
REPORT_PREVIEW_PASSWORD=
REPORT_PREVIEW_ALLOWED_IDS=[]
# Legacy standalone provider diagnostics only; production reports read Admin HTTP API.
# Do not copy Admin provider tokens or database credentials here.
# GOOGLE REAL DATA
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=
GSC_PROPERTY_URL=

# META REAL DATA
META_API_VERSION=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# TIKTOK REAL DATA
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Customer BFF: no database/provider credential is needed by this feature on Web.
CUSTOMER_AUTH_ENABLED=false
CUSTOMER_BACKEND_URL=http://127.0.0.1:8094
CUSTOMER_WEB_ORIGIN=http://127.0.0.1:8084
CUSTOMER_SERVICE_TOKEN=
